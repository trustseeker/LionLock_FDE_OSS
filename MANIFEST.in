# The sdist is meant to be self-contained: a recipient can unpack it, install it and run the test
# suite. Tests need their fixture and conftest, so the whole tests/ tree ships, together with the
# examples and docs that the README and the quickstart point to.
include LICENSE NOTICE README.md CHANGELOG.md lionlock.toml.example
graft docs
graft examples
graft tests
graft scripts
# This test checks the repository's own verification harness, which is not part of the package.
exclude tests/test_harness_porcelain.py
global-exclude __pycache__ *.py[cod] *.db *.sqlite *.sqlite3 *.jsonl .DS_Store
