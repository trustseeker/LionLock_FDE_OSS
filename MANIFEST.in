# The sdist is meant to be self-contained: a recipient can unpack it, install it and run the test
# suite. Tests need their fixture and conftest, so the whole tests/ tree ships, together with the
# examples and docs that the README and the quickstart point to.
include LICENSE NOTICE README.md CHANGELOG.md SECURITY.md lionlock.toml.example
graft docs
graft examples
graft tests
graft scripts
# These tests check the repository's own tooling (verification harness, tools/venv_guard.sh, the
# publish workflow), which is not part of the package, so they cannot pass from an unpacked sdist.
exclude tests/test_harness_porcelain.py tests/test_venv_guard.py tests/test_publish_workflow.py
global-exclude __pycache__ *.py[cod] *.db *.sqlite *.sqlite3 *.jsonl .DS_Store
